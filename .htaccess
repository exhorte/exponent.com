# exponentvalue — configuration Apache/LiteSpeed (Hostinger).
# Ce fichier vit dans public/ : Next.js le recopie dans out/ à chaque build.

# --- Page 404 -----------------------------------------------------------
# Sans cette ligne, une URL inconnue renvoie la page d'erreur Hostinger
# au lieu du 404 de la marque généré par Next.
ErrorDocument 404 /404.html

# --- Anciennes URL (V1 -> V2) ---------------------------------------------
# Les pages ont été renommées pour suivre la navigation. 301 permanent pour
# conserver les liens existants et le référencement.
<IfModule mod_alias.c>
  RedirectMatch 301 ^/platform/?$ /exponentos/
  RedirectMatch 301 ^/method/?$ /methode/
  RedirectMatch 301 ^/sectors/?$ /solutions/
  RedirectMatch 301 ^/company/?$ /entreprise/
</IfModule>

# --- Dépôt Git ----------------------------------------------------------
# Le déploiement par Git de Hostinger clone la branche `deploy` directement
# dans public_html : le dossier .git (et .github, .gitignore…) ne doit jamais
# être servi. À vérifier après chaque changement de mode de déploiement :
# https://exponentvalue.com/.git/HEAD doit répondre 404, jamais 200.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git
</IfModule>

# --- HTTPS --------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. HTTP:X-Forwarded-Proto couvre le cas où le SSL est terminé
  # en amont par le proxy Hostinger, où %{HTTPS} reste "off".
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Navigation côté client (Next 16, export statique) : le navigateur demande
  # `solutions/__next.solutions.__PAGE__.txt` alors que le fichier exporté est
  # `solutions/__next.solutions/__PAGE__.txt`. Sans cette réécriture, chaque
  # préchargement de lien renvoie un 404 (le site retombe sur une navigation
  # complète : rien ne casse, mais la console se remplit d'erreurs).
  # Selon la plateforme du build, Next écrit ce fichier à plat
  # (`__next.solutions.__PAGE__.txt`, build Linux de GitHub Actions) ou dans un
  # dossier (`__next.solutions/__PAGE__.txt`, build Windows) : on ne réécrit que
  # si le fichier demandé n'existe pas tel quel.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/__next\.(.+)\.__PAGE__\.txt$ $1/__next.$2/__PAGE__.txt [L]
</IfModule>

# --- Cache --------------------------------------------------------------
<IfModule mod_headers.c>
  # Les fichiers sous /_next/static/ portent un hash dans leur nom : leur
  # contenu ne change jamais sans que l'URL change. Cache maximal.
  <IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^_next/static/ - [E=IMMUTABLE:1]
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE

  # Le HTML, lui, doit être revalidé : c'est ce qui permet à un nouveau
  # déploiement d'être visible immédiatement.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Vidéos et polices : pas de hash dans le nom de fichier (contrairement à
  # /_next/static/), donc pas de cache "immutable" — un cache de 30 jours
  # suffit et laisse une mise à jour se propager dans un délai raisonnable.
  <FilesMatch "\.(mp4|webm|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Durcissement de base.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# --- Types --------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>
